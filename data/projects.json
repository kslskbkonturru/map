/******************************************************************************
 * Service Transformation Map (STM)
 * Renderer
 *
 * Build 003
 * Part 1
 *
 * Инициализация
 * Хранилище состояния
 * Загрузка данных
 * Главный render()
 ******************************************************************************/

'use strict';

window.STM = window.STM || {};

STM.Renderer = {

    /* =======================================================================
       State
    ======================================================================= */

    initialized: false,

    dom: {},

    program: null,

    focuses: [],

    projects: [],

    links: [],

    risks: [],

    metrics: [],

    workspace: {},

    dictionaries: {},

    history: [],

    currentFocus: null,

    currentProject: null,

    /* =======================================================================
       Initialize
    ======================================================================= */

    initialize() {

        if (this.initialized) {
            return;
        }

        this.cacheDom();

        this.initialized = true;

        console.info("Renderer initialized.");

    },

    /* =======================================================================
       Cache DOM
    ======================================================================= */

    cacheDom() {

        this.dom = {

            /* Header */

            programTitle:
                document.getElementById("program-title"),

            programGoal:
                document.getElementById("program-goal"),

            progress:
                document.getElementById("program-progress"),

            progressValue:
                document.getElementById("program-progress-value"),

            /* Main */

            focusList:
                document.getElementById("focus-list"),

            projectLayer:
                document.getElementById("project-layer"),

            riskList:
                document.getElementById("risk-list"),

            status:
                document.getElementById("status-text")

        };

    },

    /* =======================================================================
       Load Data
    ======================================================================= */

    loadData() {

        this.program =
            STM.Loader.getProgram()?.data || {};

        this.focuses =
            STM.Loader.getFocuses()?.data || [];

        this.projects =
            STM.Loader.getProjects()?.data || [];

        this.links =
            STM.Loader.getLinks()?.data || [];

        this.risks =
            STM.Loader.getRisks()?.data || [];

        this.metrics =
            STM.Loader.getMetrics()?.data || [];

        this.workspace =
            STM.Loader.getWorkspace()?.data || {};

        this.dictionaries =
            STM.Loader.getDictionary()?.data || {};

        this.history =
            STM.Loader.getHistory()?.data || [];

    },

    /* =======================================================================
       Main Render
    ======================================================================= */

    render() {

        if (!this.initialized) {

            this.initialize();

        }

        this.loadData();

        this.renderProgram();

        this.renderGoal();

        this.renderProgress();

        this.renderFocuses();

        this.renderProjects();

        this.renderRisks();

        this.renderLinks();

        this.renderTimeline();

        this.updateStatusBar();

        console.info("Renderer completed.");

    },

    /* =======================================================================
       Refresh
    ======================================================================= */

    refresh() {

        this.render();

    },

    /* =======================================================================
       Public getters
    ======================================================================= */

    getProjects() {

        return this.projects;

    },

    getFocuses() {

        return this.focuses;

    },

    getProgram() {

        return this.program;

    },

    getLinks() {

        return this.links;

    },

    getRisks() {

        return this.risks;

    },
    /* =======================================================================
       Render Program
    ======================================================================= */

    renderProgram() {

        if (!this.dom.programTitle) return;

        const name =
            this.program.name ||
            "Без названия";

        this.dom.programTitle.textContent = name;

    },

    /* =======================================================================
       Render Goal
    ======================================================================= */

    renderGoal() {

        if (!this.dom.programGoal) return;

        let text = "";

        if (this.program.goal) {

            if (typeof this.program.goal === "string") {

                text = this.program.goal;

            }

            else if (this.program.goal.description) {

                text = this.program.goal.description;

            }

            else if (this.program.goal.title) {

                text = this.program.goal.title;

            }

        }

        this.dom.programGoal.textContent =

            text || "Цель программы не задана.";

    },

    /* =======================================================================
       Render Progress
    ======================================================================= */

    renderProgress() {

        let progress = 0;

        if (

            this.program.goal &&

            typeof this.program.goal.progress === "number"

        ) {

            progress = this.program.goal.progress;

        }

        else {

            progress = this.calculateProgramProgress();

        }

        progress = Math.round(progress);

        if (this.dom.progress) {

            this.dom.progress.value = progress;

        }

        if (this.dom.progressValue) {

            this.dom.progressValue.textContent =

                progress + "%";

        }

    },

    /* =======================================================================
       Calculate Program Progress
    ======================================================================= */

    calculateProgramProgress() {

        if (

            !Array.isArray(this.projects) ||

            this.projects.length === 0

        ) {

            return 0;

        }

        let sum = 0;

        let count = 0;

        this.projects.forEach(project => {

            if (

                typeof project.progress === "number"

            ) {

                sum += project.progress;

                count++;

            }

        });

        if (count === 0) {

            return 0;

        }

        return sum / count;

    },

    /* =======================================================================
       Status Bar
    ======================================================================= */

    updateStatusBar() {

        if (!this.dom.status) return;

        const projects = this.projects.length;

        const focuses = this.focuses.length;

        const risks = this.risks.length;

        this.dom.status.textContent =

            `Фокусов: ${focuses} | Проектов: ${projects} | Рисков: ${risks}`;

    },
    /* =======================================================================
       Render Focuses
    ======================================================================= */

    renderFocuses() {

        if (!this.dom.focusList) return;

        this.dom.focusList.innerHTML = "";

        this.focuses.forEach(focus => {

            const card = this.createFocusCard(focus);

            this.dom.focusList.appendChild(card);

        });

    },

    /* =======================================================================
       Create Focus Card
    ======================================================================= */

    createFocusCard(focus) {

        const card = document.createElement("div");

        card.className = "focus-card";

        card.dataset.id = focus.id;

        if (
            this.currentFocus &&
            this.currentFocus.id === focus.id
        ) {
            card.classList.add("active");
        }

        const projects =
            this.getProjectsByFocus(focus.id);

        const progress =
            this.calculateFocusProgress(projects);

        card.innerHTML = `

            <div class="focus-header">

                <div class="focus-title">

                    ${focus.shortName || focus.name}

                </div>

                <div class="focus-progress">

                    ${progress}%

                </div>

            </div>

            <div class="focus-description">

                ${focus.description || ""}

            </div>

            <div class="focus-footer">

                <span>

                    Проектов: ${projects.length}

                </span>

                <span>

                    ${focus.status?.title || ""}

                </span>

            </div>

        `;

        card.addEventListener(

            "click",

            () => {

                this.selectFocus(focus.id);

            }

        );

        return card;

    },

    /* =======================================================================
       Select Focus
    ======================================================================= */

    selectFocus(focusId) {

        this.currentFocus =

            this.focuses.find(

                f => f.id === focusId

            ) || null;

        this.renderFocuses();

        this.renderProjects();

        this.renderLinks();

        this.renderTimeline();

    },

    /* =======================================================================
       Get Projects By Focus
    ======================================================================= */

    getProjectsByFocus(focusId) {

        return this.projects.filter(

            project =>

                project.focusId === focusId

        );

    },

    /* =======================================================================
       Calculate Focus Progress
    ======================================================================= */

    calculateFocusProgress(projects) {

        if (projects.length === 0) {

            return 0;

        }

        let sum = 0;

        let count = 0;

        projects.forEach(project => {

            if (

                typeof project.progress === "number"

            ) {

                sum += project.progress;

                count++;

            }

        });

        if (count === 0) {

            return 0;

        }

        return Math.round(

            sum / count

        );

    },
    /* =======================================================================
       Render Projects
    ======================================================================= */

    renderProjects() {

        if (!this.dom.projectLayer) return;

        this.dom.projectLayer.innerHTML = "";

        let projects = this.projects;

        if (this.currentFocus) {

            projects = this.getProjectsByFocus(

                this.currentFocus.id

            );

        }

        projects.forEach(project => {

            const card = this.createProjectCard(project);

            this.dom.projectLayer.appendChild(card);

        });

    },

    /* =======================================================================
       Create Project Card
    ======================================================================= */

    createProjectCard(project) {

        const card = document.createElement("div");

        card.className = "project-card";

        card.dataset.id = project.id;

        const progress =

            typeof project.progress === "number"

                ? project.progress

                : 0;

        const owner =

            project.owner?.name ||

            project.owner ||

            "";

        const status =

            project.status?.title ||

            project.status ||

            "";

        const priority =

            project.priority?.title ||

            project.priority ||

            "";

        const timeline =

            project.timeline

                ? `${project.timeline.start || ""} — ${project.timeline.finish || ""}`

                : "";

        card.innerHTML = `

            <div class="project-header">

                <div class="project-title">

                    ${project.name || "Без названия"}

                </div>

                <div class="project-progress">

                    ${progress}%

                </div>

            </div>

            <div class="project-description">

                ${project.description || ""}

            </div>

            <div class="project-status">

                <strong>Статус:</strong>

                ${status}

            </div>

            <div class="project-owner">

                <strong>Владелец:</strong>

                ${owner}

            </div>

            <div class="project-priority">

                <strong>Приоритет:</strong>

                ${priority}

            </div>

            <div class="project-timeline">

                ${timeline}

            </div>

        `;

        card.addEventListener(

            "click",

            () => {

                this.openProject(project.id);

            }

        );

        return card;

    },

    /* =======================================================================
       Open Project
    ======================================================================= */

    openProject(projectId) {

        const project = this.projects.find(

            p => p.id === projectId

        );

        if (!project) return;

        this.currentProject = project;

        if (

            STM.Modal &&

            typeof STM.Modal.open === "function"

        ) {

            STM.Modal.open(

                "project",

                project

            );

        }

    },
    /* =======================================================================
       Render Risks
    ======================================================================= */

    renderRisks() {

        if (!this.dom.riskList) return;

        this.dom.riskList.innerHTML = "";

        this.risks.forEach(risk => {

            const item = document.createElement("div");

            item.className = "risk-card";

            item.innerHTML = `

                <div class="risk-title">

                    ${risk.name || risk.title || "Риск"}

                </div>

                <div class="risk-description">

                    ${risk.description || ""}

                </div>

            `;

            this.dom.riskList.appendChild(item);

        });

    },

    /* =======================================================================
       Render SVG Links
    ======================================================================= */

    renderLinks() {

        if (

            STM.SVG &&

            typeof STM.SVG.renderFiltered === "function"

        ) {

            if (this.currentFocus) {

                const ids =

                    this.getProjectsByFocus(

                        this.currentFocus.id

                    ).map(

                        p => p.id

                    );

                STM.SVG.renderFiltered(ids);

            }

            else {

                STM.SVG.renderFiltered();

            }

            return;

        }

        if (

            STM.SVG &&

            typeof STM.SVG.render === "function"

        ) {

            STM.SVG.render(this.links);

        }

    },

    /* =======================================================================
       Render Timeline
    ======================================================================= */

    renderTimeline() {

        if (

            !STM.Timeline ||

            typeof STM.Timeline.render !== "function"

        ) {

            return;

        }

        if (this.currentFocus) {

            STM.Timeline.projects =

                this.getProjectsByFocus(

                    this.currentFocus.id

                );

        }

        else {

            STM.Timeline.projects =

                this.projects;

        }

        STM.Timeline.render(this.history);

    },

    /* =======================================================================
       Find Project
    ======================================================================= */

    findProject(projectId) {

        return this.projects.find(

            p => p.id === projectId

        ) || null;

    },

    /* =======================================================================
       Find Focus
    ======================================================================= */

    findFocus(focusId) {

        return this.focuses.find(

            f => f.id === focusId

        ) || null;

    },

    /* =======================================================================
       Reset Selection
    ======================================================================= */

    clearSelection() {

        this.currentFocus = null;

        this.currentProject = null;

    },

    /* =======================================================================
       Full Refresh
    ======================================================================= */

    rerender() {

        this.clearSelection();

        this.render();

    },

    /* =======================================================================
       Destroy
    ======================================================================= */

    destroy() {

        this.clearSelection();

        if (this.dom.focusList) {

            this.dom.focusList.innerHTML = "";

        }

        if (this.dom.projectLayer) {

            this.dom.projectLayer.innerHTML = "";

        }

        if (this.dom.riskList) {

            this.dom.riskList.innerHTML = "";

        }

        this.initialized = false;

    }

};
