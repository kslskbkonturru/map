{
  "meta": {
    "schema": "stm/workspace/v1",
    "version": "1.0",
    "updated": "2026-07-30",
    "author": "Service Transformation Map"
  },

  "data": {

    "canvas": {
      "width": 1600,
      "height": 900,
      "padding": 60,
      "grid": 20,
      "background": "default"
    },

    "view": {
      "defaultView": "roadmap",
      "zoom": 100,
      "center": true,
      "showGrid": false,
      "showConnections": true,
      "showTimeline": true,
      "showProgress": true,
      "showStatusBar": true,
      "showAttentionPanel": true
    },

    "views": [

      {
        "id": "roadmap",
        "title": "Дорожная карта",
        "description": "Основное представление программы",

        "groupBy": "focus",

        "showTimeline": true,
        "showConnections": true,
        "showProgress": true,
        "showAttentionPanel": true
      },

      {
        "id": "dependencies",
        "title": "Карта зависимостей",
        "description": "Отображение зависимостей между проектами",

        "groupBy": "dependency",

        "showTimeline": false,
        "showConnections": true,
        "showProgress": false,
        "showAttentionPanel": true
      },

      {
        "id": "owners",
        "title": "По владельцам",
        "description": "Группировка проектов по ответственным",

        "groupBy": "owner",

        "showTimeline": false,
        "showConnections": false,
        "showProgress": true,
        "showAttentionPanel": false
      }

    ],

    "zones": [

      {
        "id": "zone-service-levels",
        "focusId": "focus-service-levels",

        "title": "Уровни сервиса",

        "order": 1
      },

      {
        "id": "zone-requests",
        "focusId": "focus-request-management",

        "title": "Решаем запросы клиентов",

        "order": 2
      },

      {
        "id": "zone-voc",
        "focusId": "focus-voc",

        "title": "Voice of Customer",

        "order": 3
      },

      {
        "id": "zone-cxi",
        "focusId": "focus-cxi",

        "title": "CX Intelligence",

        "order": 4
      }

    ],

    "lanes": [

      {
        "id": "lane-core",

        "title": "Ключевые проекты",

        "order": 1
      },

      {
        "id": "lane-support",

        "title": "Поддерживающие проекты",

        "order": 2
      }

    ],

    "nodes": [

      {
        "projectId": "project-service-level-model",

        "zoneId": "zone-service-levels",

        "laneId": "lane-core",

        "position": 1
      },

      {
        "projectId": "project-service-catalog",

        "zoneId": "zone-requests",

        "laneId": "lane-core",

        "position": 1
      },

      {
        "projectId": "project-routing",

        "zoneId": "zone-requests",

        "laneId": "lane-core",

        "position": 2
      },

      {
        "projectId": "project-voc-platform",

        "zoneId": "zone-voc",

        "laneId": "lane-core",

        "position": 1
      },

      {
        "projectId": "project-cxi-dashboard",

        "zoneId": "zone-cxi",

        "laneId": "lane-core",

        "position": 1
      }

    ],

    "legend": {

      "statuses": {

        "planned": "Запланирован",

        "active": "В реализации",

        "paused": "Приостановлен",

        "completed": "Завершен"

      },

      "priorities": {

        "low": "Низкий",

        "medium": "Средний",

        "high": "Высокий",

        "critical": "Критический"

      }

    }

  }
}
